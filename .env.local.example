# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets.

# Safe to expose in the browser (this is what "publishable" means)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. REQUIRED as of Phase 2 - used by ASHA-assisted patient
# registration (creating an auth.users row for a patient with no
# email/device of their own) and by /api/reminders/dispatch. Never
# exposed to the browser; see lib/supabase/admin.ts for the only two
# call sites allowed to import it.
# Find it in Supabase dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary - CLOUD_NAME is not sensitive, KEY/SECRET are server-only
# and must never be prefixed with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
