# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets.

# Safe to expose in the browser (this is what "publishable" means)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed later for admin-level operations (Phase 5+).
# Find it in Supabase dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary - CLOUD_NAME is not sensitive, KEY/SECRET are server-only
# and must never be prefixed with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
