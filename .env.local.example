# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets.

# Safe to expose in the browser (this is what "publishable" means)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. REQUIRED as of Phase 2 - used by ASHA-assisted patient
# registration, /api/reminders/dispatch, the SMS/USSD/IVR webhooks and
# the Public Health Index. Never exposed to the browser; see
# lib/supabase/admin.ts for the call sites allowed to import it.
# Find it in Supabase dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary - CLOUD_NAME is not sensitive, KEY/SECRET are server-only
# and must never be prefixed with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PHI encryption --------------------------------------------------------
# REQUIRED. 32 random bytes, base64. Encrypts diagnoses, symptoms, clinical
# notes, triage text, addresses, emergency contacts and SMS bodies before
# they reach the database (AES-256-GCM, lib/phi-crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted records unreadable - store a backup.
PHI_ENCRYPTION_KEY=
# Only during a key rotation: the previous key, so older rows still decrypt.
PHI_ENCRYPTION_KEY_PREVIOUS=

# --- AI triage (Claude) ----------------------------------------------------
# Server-only. Powers the AI symptom checker on web, voice, SMS and IVR.
# If unset or unreachable, triage falls back to the rule-based engine.
ANTHROPIC_API_KEY=
# "true" forces rule-based triage only (offline demos, cost control).
AI_TRIAGE_DISABLED=

# --- SMS / USSD / IVR for keypad phones -------------------------------------
# "twilio" delivers for real. Unset = simulated: messages are logged and
# recorded as Simulated, never marked Sent.
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
# Also used to verify X-Twilio-Signature on /api/sms/inbound and /api/ivr/*.
TWILIO_AUTH_TOKEN=
# SMS- and voice-capable number, E.164 (e.g. +1415...). Or a messaging service.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# The public base URL Twilio calls - needed to validate its signatures behind
# proxies, e.g. https://swasthsetu.vercel.app or your ngrok URL.
PUBLIC_APP_URL=
# Shared secret for gateways that can't sign requests (USSD aggregators,
# local curl testing): send as an x-webhook-secret header or ?key= param.
TELECOM_WEBHOOK_SECRET=
# Protects POST /api/reminders/dispatch (Vercel Cron sends it as a Bearer
# token). Strongly recommended in any deployed environment.
CRON_SECRET=
